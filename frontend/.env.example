# Frontend Environment Variables

# Legacy Render API URL (Kept for rollback/parallel testing until verification is complete)
VITE_API_URL=http://localhost:3001/api

# Firebase Web App Configuration
VITE_FIREBASE_API_KEY=""
VITE_FIREBASE_AUTH_DOMAIN="devhub-app.firebaseapp.com"
VITE_FIREBASE_PROJECT_ID="devhub-app"
VITE_FIREBASE_STORAGE_BUCKET="devhub-app.firebasestorage.app"
VITE_FIREBASE_MESSAGING_SENDER_ID=""
VITE_FIREBASE_APP_ID=""

# Set to 'true' to connect directly to local Firebase Emulators
VITE_USE_FIREBASE_EMULATOR=false
