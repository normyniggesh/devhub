rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {
    
    function isAuthenticated() {
      return request.auth != null;
    }
    
    function isProjectOwner(projectId) {
      return isAuthenticated() && 
             firestore.exists(/databases/(default)/documents/projects/$(projectId)) &&
             firestore.get(/databases/(default)/documents/projects/$(projectId)).data.ownerId == request.auth.uid;
    }

    function isProjectMember(projectId) {
      return isAuthenticated() && (
        isProjectOwner(projectId) ||
        firestore.exists(/databases/(default)/documents/projects/$(projectId)/members/$(request.auth.uid))
      );
    }
    
    function getRole(projectId) {
      return isProjectOwner(projectId) 
        ? 'Admin' 
        : (firestore.exists(/databases/(default)/documents/projects/$(projectId)/members/$(request.auth.uid))
            ? firestore.get(/databases/(default)/documents/projects/$(projectId)/members/$(request.auth.uid)).data.role
            : null);
    }
    
    function isEditorOrAdmin(projectId) {
      return isProjectMember(projectId) && (getRole(projectId) == 'Editor' || getRole(projectId) == 'Admin');
    }
    
    function isAdmin(projectId) {
      return isProjectMember(projectId) && getRole(projectId) == 'Admin';
    }

    match /projects/{projectId}/{allPaths=**} {
      // Any verified project member (including Viewer) can download files
      allow read: if isProjectMember(projectId);
      
      // Upload/write allowed for Editor and Admin with size limit <= 50MB
      allow create: if isEditorOrAdmin(projectId) && request.resource.size <= 50 * 1024 * 1024;
      allow update: if isEditorOrAdmin(projectId) && request.resource.size <= 50 * 1024 * 1024;
      
      // Deletions strictly Admin and Owner
      allow delete: if isAdmin(projectId);
    }
  }
}
