rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    // Auth helpers
    function isAuthenticated() {
      return request.auth != null;
    }
    
    function isOwner(userId) {
      return isAuthenticated() && request.auth.uid == userId;
    }
    
    function projectExists(projectId) {
      return exists(/databases/$(database)/documents/projects/$(projectId));
    }

    function isProjectOwner(projectId) {
      return isAuthenticated() && 
             projectExists(projectId) && 
             get(/databases/$(database)/documents/projects/$(projectId)).data.ownerId == request.auth.uid;
    }
    
    function isProjectMember(projectId) {
      return isAuthenticated() && (
        isProjectOwner(projectId) || 
        exists(/databases/$(database)/documents/projects/$(projectId)/members/$(request.auth.uid))
      );
    }
    
    function getRole(projectId) {
      return isProjectOwner(projectId) ? 'Admin' : (
        exists(/databases/$(database)/documents/projects/$(projectId)/members/$(request.auth.uid))
          ? get(/databases/$(database)/documents/projects/$(projectId)/members/$(request.auth.uid)).data.role
          : null
      );
    }
    
    function isEditorOrAdmin(projectId) {
      return isProjectMember(projectId) && (getRole(projectId) == 'Editor' || getRole(projectId) == 'Admin');
    }
    
    function isAdmin(projectId) {
      return isProjectMember(projectId) && getRole(projectId) == 'Admin';
    }

    // 1. Users directory
    match /users/{userId} {
      allow read: if isAuthenticated();
      allow create, update: if isOwner(userId);
      allow delete: if false;
    }

    // 2. Projects and Project Members
    match /projects/{projectId} {
      allow read: if isProjectMember(projectId);
      allow create: if isAuthenticated() && request.resource.data.ownerId == request.auth.uid;
      allow update: if isEditorOrAdmin(projectId);
      allow delete: if isAdmin(projectId);

      match /members/{memberId} {
        allow read: if isProjectMember(projectId);
        allow create, update: if isAdmin(projectId);
        allow delete: if isAdmin(projectId) || request.auth.uid == memberId;
      }
    }

    // 2b. Top-level Project Members
    match /projectMembers/{pmId} {
      allow read: if isProjectMember(resource.data.projectId);
      allow create, update: if isAdmin(request.resource.data.projectId);
      allow delete: if isAdmin(resource.data.projectId) || request.auth.uid == resource.data.userId;
    }

    // 3. Tasks
    match /tasks/{taskId} {
      allow read: if isProjectMember(resource.data.projectId);
      allow create: if isEditorOrAdmin(request.resource.data.projectId) &&
                       request.resource.data.creatorId == request.auth.uid;
      
      allow update: if isProjectMember(resource.data.projectId) && (
        // Admin or Owner can perform all updates
        isAdmin(resource.data.projectId) ||
        // Assigned user can complete active task
        (
          resource.data.assigneeId == request.auth.uid &&
          request.resource.data.status in ['Done', 'Completed'] &&
          !(resource.data.status in ['Done', 'Completed']) &&
          request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status', 'completedAt', 'updatedAt'])
        ) ||
        // Editor can update active tasks, and can complete active tasks, but CANNOT reopen Done tasks
        (
          isEditorOrAdmin(resource.data.projectId) &&
          !(resource.data.status in ['Done', 'Completed'] && !(request.resource.data.status in ['Done', 'Completed'])) &&
          (
            request.resource.data.status == resource.data.status || 
            (request.resource.data.status in ['Done', 'Completed'] && (resource.data.assigneeId == request.auth.uid || isAdmin(resource.data.projectId))) ||
            (!(request.resource.data.status in ['Done', 'Completed']) && !(resource.data.status in ['Done', 'Completed']))
          )
        )
      );

      allow delete: if isAdmin(resource.data.projectId);
    }

    // 3b. Task Comments
    match /taskComments/{commentId} {
      allow read: if isProjectMember(resource.data.projectId);
      allow create: if isProjectMember(request.resource.data.projectId) &&
                       request.resource.data.userId == request.auth.uid;
      allow update: if isProjectMember(resource.data.projectId) &&
                       resource.data.userId == request.auth.uid;
      allow delete: if isProjectMember(resource.data.projectId) && (
        resource.data.userId == request.auth.uid || isAdmin(resource.data.projectId)
      );
    }

    // 3c. Task Attachments
    match /taskAttachments/{attachmentId} {
      allow read: if isProjectMember(resource.data.projectId);
      allow create: if isEditorOrAdmin(request.resource.data.projectId) &&
                       request.resource.data.userId == request.auth.uid;
      allow update: if isEditorOrAdmin(resource.data.projectId);
      allow delete: if isAdmin(resource.data.projectId) || resource.data.userId == request.auth.uid;
    }

    // 4. Test Cases
    match /testCases/{tcId} {
      allow read: if isProjectMember(resource.data.projectId);
      allow create: if isEditorOrAdmin(request.resource.data.projectId) &&
                       request.resource.data.creatorId == request.auth.uid;
      allow update: if isEditorOrAdmin(resource.data.projectId);
      allow delete: if isAdmin(resource.data.projectId);
    }

    // 5. Test Runs
    match /testRuns/{trId} {
      allow read: if isProjectMember(resource.data.projectId);
      allow create, update: if isEditorOrAdmin(request.resource.data.projectId);
      allow delete: if isAdmin(resource.data.projectId);
    }

    // 6. Test Results
    match /testResults/{tresId} {
      allow read: if isProjectMember(resource.data.projectId);
      allow create, update: if isEditorOrAdmin(request.resource.data.projectId);
      allow delete: if isAdmin(resource.data.projectId);
    }

    // 7. Bugs
    match /bugs/{bugId} {
      allow read: if isProjectMember(resource.data.projectId);
      allow create: if isEditorOrAdmin(request.resource.data.projectId) &&
                       request.resource.data.creatorId == request.auth.uid;
      allow update: if isEditorOrAdmin(resource.data.projectId);
      allow delete: if isAdmin(resource.data.projectId);
    }

    // 8. Calendar Events
    match /calendarEvents/{eventId} {
      allow read: if (resource.data.projectId == null && resource.data.creatorId == request.auth.uid) ||
                     (resource.data.projectId != null && isProjectMember(resource.data.projectId));
      allow create: if isAuthenticated() && (
        (request.resource.data.projectId == null && request.resource.data.creatorId == request.auth.uid) ||
        (request.resource.data.projectId != null && isEditorOrAdmin(request.resource.data.projectId))
      );
      allow update: if isAuthenticated() && (
        (resource.data.projectId == null && resource.data.creatorId == request.auth.uid) ||
        (resource.data.projectId != null && isEditorOrAdmin(resource.data.projectId))
      );
      allow delete: if isAuthenticated() && (
        (resource.data.projectId == null && resource.data.creatorId == request.auth.uid) ||
        (resource.data.projectId != null && isAdmin(resource.data.projectId))
      );
    }

    // 9. Folders
    match /folders/{folderId} {
      allow read: if isProjectMember(resource.data.projectId);
      allow create: if isEditorOrAdmin(request.resource.data.projectId) &&
                       request.resource.data.creatorId == request.auth.uid;
      allow update: if isEditorOrAdmin(resource.data.projectId);
      allow delete: if isAdmin(resource.data.projectId);
    }

    // 10. Files Metadata
    match /files/{fileId} {
      allow read: if isProjectMember(resource.data.projectId);
      allow create: if isEditorOrAdmin(request.resource.data.projectId) &&
                       request.resource.data.uploaderId == request.auth.uid;
      allow update: if isEditorOrAdmin(resource.data.projectId);
      allow delete: if isAdmin(resource.data.projectId);
    }

    // 11. Repositories
    match /repositories/{repoId} {
      allow read: if isProjectMember(resource.data.projectId);
      allow create, update: if isEditorOrAdmin(request.resource.data.projectId);
      allow delete: if isAdmin(resource.data.projectId);
    }

    // 12. Pull Requests
    match /pullRequests/{prId} {
      allow read: if isProjectMember(resource.data.projectId);
      allow create, update: if isEditorOrAdmin(request.resource.data.projectId);
      allow delete: if isAdmin(resource.data.projectId);
    }

    // 13. Deployments
    match /deployments/{depId} {
      allow read: if isProjectMember(resource.data.projectId);
      allow create, update: if isEditorOrAdmin(request.resource.data.projectId);
      allow delete: if isAdmin(resource.data.projectId);
    }

    // 14. Notifications
    match /notifications/{notifId} {
      allow read, update, delete: if isAuthenticated() && resource.data.userId == request.auth.uid;
      allow create: if isAuthenticated();
    }

    // 15. Audit Logs
    match /auditLogs/{logId} {
      allow read: if isAuthenticated() && (
        resource.data.userId == request.auth.uid ||
        (resource.data.projectId != null && isProjectMember(resource.data.projectId))
      );
      allow create: if isAuthenticated() && request.resource.data.userId == request.auth.uid;
      allow update, delete: if false; // Immutable audit trail
    }

    // 16. Milestones
    match /milestones/{milestoneId} {
      allow read: if isProjectMember(resource.data.projectId);
      allow create, update: if isEditorOrAdmin(request.resource.data.projectId);
      allow delete: if isAdmin(resource.data.projectId);
    }
  }
}
